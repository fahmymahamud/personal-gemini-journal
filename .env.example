# Copy to .env and fill in. .env is gitignored — never commit real values.
# On Cloud Run these are injected from Secret Manager instead (build step 7).

PORT=8080

# --- Gemini API (AI Studio key, NOT Vertex AI) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Firebase Admin (server side) ---
# Credentials come from Application Default Credentials, never a key file
# (service-account key creation is blocked by org policy).
#   Local:     gcloud auth application-default login
#   Cloud Run: automatic, from the runtime service account.
# Deliberately do NOT set GOOGLE_APPLICATION_CREDENTIALS — setting it points
# ADC at a key file instead of the credentials above.
GOOGLE_CLOUD_PROJECT=elemental-component-27dgj

# --- Firebase Web config (served to the browser via GET /api/config) ---
# These are not secrets (they identify, they don't authorise) but they stay in
# env so nothing project-specific is baked into public/.
# Firebase console > Project settings > Your apps > Web app > SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=elemental-component-27dgj.firebaseapp.com
FIREBASE_PROJECT_ID=elemental-component-27dgj
FIREBASE_STORAGE_BUCKET=elemental-component-27dgj.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Signs the per-coach ICS calendar feed token (any long random string).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CALENDAR_SECRET=

# From BotFather. Stored in Secret Manager as telegram-bot-token.
TELEGRAM_BOT_TOKEN=

# Any long random string. The same value goes in the Meta dashboard when the
# WhatsApp webhook is saved; Meta echoes it back on the verification GET.
# Stored in Secret Manager as whatsapp-verify-token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WHATSAPP_VERIFY_TOKEN=

# Firebase uid of the administrator. Grants /admin; never subject to the allowlist.
ADMIN_UID=

# Demo accounts for scripts/seed-demo.js. Documented in README.md for judges.
DEMO_PASSWORD=
DEMO_COACH_EMAIL=demo@remindclient.app
DEMO_ADMIN_EMAIL=admin@remindclient.app

# Verifies Telegram webhook calls. Must match setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta). Leave blank to fall back to wa.me links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
